[Unit]
Description=AD9364 spectrum analyzer (forgecpp)
After=network-online.target radio-controller.service
Wants=network-online.target
# backend = "radio": RX2 comes from radio-controller (started first if both are enabled).
# backend = "iio": the analyzer owns the RX path; do not run radio-controller then.

[Service]
Type=notify
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/spectrum-analyzer --config @CMAKE_INSTALL_FULL_SYSCONFDIR@/spectrum-analyzer/spectrum-analyzer.toml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2
WatchdogSec=30
StateDirectory=spectrum-analyzer

[Install]
WantedBy=multi-user.target
