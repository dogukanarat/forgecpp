# Generates a C++ source embedding files as forge::web::Asset tables.
# Invoked by forge_add_web() at build time:
#   cmake -DMANIFEST=<file> -DOUTPUT=<cpp> -DSYMBOL=<name> -DREGISTER=ON|OFF -P ForgeEmbed.cmake
# MANIFEST lines: <absolute file path>|<url path>

cmake_minimum_required(VERSION 3.16)

foreach(var MANIFEST OUTPUT SYMBOL)
    if(NOT DEFINED ${var})
        message(FATAL_ERROR "ForgeEmbed.cmake: ${var} is required")
    endif()
endforeach()

file(STRINGS "${MANIFEST}" entries)

set(defs "")
set(table "")
set(count 0)
foreach(entry IN LISTS entries)
    if(entry STREQUAL "")
        continue()
    endif()
    string(FIND "${entry}" "|" sep)
    string(SUBSTRING "${entry}" 0 ${sep} path)
    math(EXPR start "${sep} + 1")
    string(SUBSTRING "${entry}" ${start} -1 url)
    string(REPLACE "\\" "\\\\" url "${url}")
    string(REPLACE "\"" "\\\"" url "${url}")

    file(READ "${path}" hex HEX)
    string(LENGTH "${hex}" hex_len)
    math(EXPR size "${hex_len} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")

    string(APPEND defs "// ${url}\nconst unsigned char asset_${count}[] = {${bytes}0x00};\n")
    string(APPEND table "    {\"${url}\", asset_${count}, ${size}},\n")
    math(EXPR count "${count} + 1")
endforeach()

if(count EQUAL 0)
    set(table "    {\"\", nullptr, 0},\n")
endif()

set(register "")
if(REGISTER)
    set(register "
namespace {
struct Registrar {
    Registrar() { forge::web::register_assets(assets, ${count}); }
} registrar;
}  // namespace
")
endif()

file(WRITE "${OUTPUT}.tmp" "// Generated by forgecpp ForgeEmbed.cmake - do not edit.
#include <forge/assets.hpp>

namespace {
${defs}
const forge::web::Asset assets[] = {
${table}};
}  // namespace

namespace forge::web::generated {
const forge::web::Asset* ${SYMBOL}(std::size_t& count) {
    count = ${count};
    return assets;
}
}  // namespace forge::web::generated
${register}")
file(RENAME "${OUTPUT}.tmp" "${OUTPUT}")
