# Generated by forge_add_app() for @FORGE_UNIT_NAME@.
[Unit]
Description=@FORGE_UNIT_DESCRIPTION@
After=network-online.target@FORGE_UNIT_AFTER@
Wants=network-online.target@FORGE_UNIT_WANTS@
# Restart policy (forge_add_app RESTART_WINDOW / MAX_RESTARTS): at most
# MAX_RESTARTS restarts within RESTART_WINDOW seconds, then the unit is failed
# and stays down until started again (forge-hub shows it and raises an alarm).
StartLimitIntervalSec=@FORGE_UNIT_START_LIMIT_INTERVAL@
StartLimitBurst=@FORGE_UNIT_START_LIMIT_BURST@

[Service]
Type=notify
ExecStart=@FORGE_UNIT_EXEC@
ExecReload=/bin/kill -HUP $MAINPID
Restart=@FORGE_UNIT_RESTART@
RestartSec=@FORGE_UNIT_RESTART_DELAY@
# A main loop that stops feeding the watchdog this long is hung: killed and restarted.
WatchdogSec=@FORGE_UNIT_WATCHDOG@
StateDirectory=@FORGE_UNIT_NAME@
@FORGE_UNIT_EXTRA@
[Install]
WantedBy=multi-user.target
