prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: forgecpp
Description: @PROJECT_DESCRIPTION@
URL: @PROJECT_HOMEPAGE_URL@
Version: @PROJECT_VERSION@
Requires: @FORGECPP_PC_REQUIRES@
Cflags: -I${includedir} -I${includedir}/concurrentqueue -std=c++17 -pthread @FORGECPP_PC_DEFINES@
Libs: -L${libdir} -lforgecpp -pthread
Libs.private: -lreplxx
