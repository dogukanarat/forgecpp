@PACKAGE_INIT@

# Where this install keeps its files, from the config's own location (works
# with any libdir and datadir; set_and_check refuses a broken install). Before
# the dependencies: their configs redefine set_and_check and PACKAGE_PREFIX_DIR.
set_and_check(FORGECPP_DATADIR "@PACKAGE_CMAKE_INSTALL_DATADIR@/forgecpp")
set_and_check(FORGECPP_PROTO_DIR "${FORGECPP_DATADIR}/proto")
set(FORGECPP_LIBEXECDIR "@PACKAGE_CMAKE_INSTALL_LIBEXECDIR@/forgecpp")

include(CMakeFindDependencyMacro)

set(THREADS_PREFER_PTHREAD_FLAG ON)
find_dependency(Threads)
find_dependency(quill           CONFIG)
find_dependency(CLI11           CONFIG)
find_dependency(concurrentqueue CONFIG)
find_dependency(nlohmann_json   CONFIG)
find_dependency(tomlplusplus    CONFIG)
find_dependency(httplib         CONFIG)

find_dependency(cppzmq          CONFIG)
# forge_add_proto() runs protoc on the build machine: from the bundled
# protobuf's CMake package when it is there, else FORGE_PROTOC or the PATH.
# Nothing links libprotobuf.
find_package(protobuf CONFIG QUIET)
set(forgecpp_zmq_FOUND ON)

# Needed for forgecpp::testing.
if(@FORGECPP_HAS_TESTING@)
    find_dependency(doctest     CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/forgecppTargets.cmake")

# Optional components this install has: find_package(forgecpp COMPONENTS sqlite lz4).
foreach(_forge_component sqlite lz4)
    if(TARGET forgecpp::${_forge_component})
        set(forgecpp_${_forge_component}_FOUND ON)
    else()
        set(forgecpp_${_forge_component}_FOUND OFF)
    endif()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/ForgeHelpers.cmake")

check_required_components(forgecpp)
