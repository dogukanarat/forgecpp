#!/usr/bin/env bash
# forgecpp-new: create a ready-to-build forgecpp application.
#
#   forgecpp-new mydaemon            # creates ./mydaemon
#   forgecpp-new mydaemon -d ~/src   # creates ~/src/mydaemon

set -euo pipefail

usage() {
    cat <<EOF
Usage: forgecpp-new <name> [-d DIR] [--description TEXT] [--force]

<name> is the daemon name: lowercase words separated by '-' (e.g. pump-controller);
other spellings are converted (Pump_Controller -> pump-controller).

Creates a new forgecpp application in DIR/<name> with:
  CMakeLists.txt, src/<name>.hpp + main.cpp, proto/<name>/v1/<name>.proto,
  web/index.html, config/<name>.toml (systemd unit generated by CMake),
  tests/test_<name>.cpp, clients/watch.py, README.md

Options:
  -d, --dir DIR          Parent directory (default: current directory)
  --description TEXT     One line description
  -f, --force            Write into an existing, non-empty directory
  -h, --help             Show this help
EOF
}

NAME=""
PARENT="."
DESCRIPTION=""
FORCE=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        -d|--dir)        PARENT="${2:?missing value for $1}"; shift 2 ;;
        --description)   DESCRIPTION="${2:?missing value for $1}"; shift 2 ;;
        -f|--force)      FORCE=1; shift ;;
        -h|--help)       usage; exit 0 ;;
        -*)              echo "unknown option: $1" >&2; usage >&2; exit 1 ;;
        *)               [[ -z "${NAME}" ]] || { echo "only one name allowed" >&2; exit 1; }
                         NAME="$1"; shift ;;
    esac
done

[[ -n "${NAME}" ]] || { usage >&2; exit 1; }
if [[ ! "${NAME}" =~ ^[A-Za-z][A-Za-z0-9_-]*$ ]]; then
    echo "invalid name '${NAME}': use letters, digits, '-' and '_' (start with a letter)" >&2
    exit 1
fi
# Daemon naming standard: lowercase words separated by '-' (the binary, config
# file, systemd unit and forge-hub entry all use it): My_Daemon / MyDaemon -> my-daemon.
STD="$(echo "${NAME}" | sed -E 's/([a-z0-9])([A-Z])/\1-\2/g' | tr '[:upper:]' '[:lower:]' | tr '_' '-' | sed -E 's/-+/-/g; s/-$//')"
if [[ "${STD}" != "${NAME}" ]]; then
    echo "name: ${NAME} -> ${STD} (daemon names are lowercase words separated by '-')"
    NAME="${STD}"
fi
[[ -n "${DESCRIPTION}" ]] || DESCRIPTION="${NAME} service built with forgecpp"

DIR="${PARENT%/}/${NAME}"
if [[ -e "${DIR}" && ${FORCE} -eq 0 && -n "$(ls -A "${DIR}" 2>/dev/null)" ]]; then
    echo "${DIR} already exists and is not empty (use --force)" >&2
    exit 1
fi

# my-daemon -> MyDaemon, my_daemon -> MyDaemon
CLASS="$(echo "${NAME}" | sed -E 's/(^|[-_])([a-z])/\U\2/g; s/[-_]//g')"
IDENT="$(echo "${NAME}" | tr '-' '_')"
PKG="$(echo "${IDENT}" | tr '[:upper:]' '[:lower:]')"   # protobuf package

mkdir -p "${DIR}/src" "${DIR}/web" "${DIR}/config" "${DIR}/tests" "${DIR}/proto/${PKG}/v1" "${DIR}/clients"

# ---------------------------------------------------------------------------
cat > "${DIR}/CMakeLists.txt" <<EOF
cmake_minimum_required(VERSION 3.16)
project(${IDENT} VERSION 0.1.0 DESCRIPTION "${DESCRIPTION}" LANGUAGES CXX)

include(GNUInstallDirs)
find_package(forgecpp 0.3 REQUIRED)

# The application's messages (forge.v1 framing, see proto/): C++ for the app
# and its tests, Python modules for clients.
add_library(${IDENT}_messages STATIC)
forge_add_proto(${IDENT}_messages ROOT proto PROTOS ${PKG}/v1/${PKG}.proto
                PYTHON "\${CMAKE_CURRENT_BINARY_DIR}/python")
target_link_libraries(${IDENT}_messages PUBLIC forgecpp::forgecpp)

forge_add_app(${NAME}
    SOURCES src/main.cpp
    LIBS    ${IDENT}_messages
    CONFIG  config/${NAME}.toml
    WEB     web
    # systemd unit with the restart policy: a crash or a hung main loop (watchdog)
    # is restarted, at most 3 times in 10 minutes; then the unit fails.
    DESCRIPTION "${DESCRIPTION}"
    RESTART on-failure MAX_RESTARTS 3 RESTART_WINDOW 600 RESTART_DELAY 2 WATCHDOG 30)
target_compile_definitions(${NAME} PRIVATE APP_VERSION="\${PROJECT_VERSION}")
install(FILES proto/${PKG}/v1/${PKG}.proto DESTINATION \${CMAKE_INSTALL_DATADIR}/${NAME}/proto/${PKG}/v1)
forge_install_python(DIRECTORY "\${CMAKE_CURRENT_BINARY_DIR}/python")  # ${PKG}.v1 in site-packages
install(PROGRAMS clients/watch.py DESTINATION \${CMAKE_INSTALL_DATADIR}/${NAME}/clients)

include(CTest)
if(BUILD_TESTING)
    forge_add_test(${IDENT}_tests SOURCES tests/test_${IDENT}.cpp LIBS ${IDENT}_messages)
    target_include_directories(${IDENT}_tests PRIVATE src)
    target_compile_definitions(${IDENT}_tests PRIVATE
        APP_CONFIG_FILE="\${CMAKE_CURRENT_SOURCE_DIR}/config/${NAME}.toml")
endif()
EOF

# ---------------------------------------------------------------------------
cat > "${DIR}/proto/${PKG}/v1/${PKG}.proto" <<EOF
// ${NAME} messages. They travel in the forge.v1 framing:
//   [topic][forge.v1.Header][message][optional blob]
// Add fields with new numbers; never reuse or renumber (old clients keep working).
syntax = "proto3";

package ${PKG}.v1;

// Stream "ticks" on [forge].data.
message Tick {
  uint64 count = 1;
  string message = 2;
  int64 interval_ms = 3;
}
EOF

# ---------------------------------------------------------------------------
cat > "${DIR}/src/${IDENT}.hpp" <<EOF
#pragma once
// ${NAME}: ${DESCRIPTION}
//
// Every forgecpp application has the same ways in, configured in
// config/${NAME}.toml:
//   web        http://<host>:8080/ (web/index.html) and /forge/ (control panel:
//              controls, commands, health, metrics, audit, leases, trace)
//   forge.v1   [forge].control  forgectl -e tcp://<host>:5557 controls|set|call|logs|watch ...
//              [forge].events   state, alarms, logs, audit, health, metrics (PUB)
//              [forge].data     this application's streams (PUB, "ticks")
//   console    -i (local) or telnet <host> 2323 ([console].telnet)

#include <forge/forge.hpp>
#include <forge/zmq.hpp>

#include "${PKG}/v1/${PKG}.pb.h"

#ifndef APP_VERSION
#define APP_VERSION "0.0.0"
#endif

class ${CLASS} : public forge::Application {
public:
    ${CLASS}() : Application({"${NAME}", APP_VERSION, "${DESCRIPTION}"}) {}

    std::uint64_t ticks() const { return ticks_; }

protected:
    // Configuration keys: validated at start-up and on reload, listed by
    // --help-config, typos are reported with a suggestion.
    void setup_config(forge::config::Schema& s) override {
        s.section("${IDENT}", "${NAME}");
        s.integer("${IDENT}.interval_ms", 1000, "Tick period").range(10, 60000).unit("ms");
        s.string("${IDENT}.message", "tick", "Logged on every tick");
    }

    // Extra command line options.
    void setup_cli(CLI::App& cli) override {
        cli.add_flag("--dry-run", dry_run_, "Do everything except side effects");
    }

    // Controls and commands: the web pages, /forge/, forgectl, the console
    // and telnet all use these (with roles, leases and the audit trail).
    void setup_web(forge::web::Dashboard& ui) override {
        apply(config());
        ui.link("Home", "/");
        auto& g = ui.group("${CLASS}");
        g.value("ticks", "Ticks", ticks_);
        g.toggle("paused", "Paused", paused_).persist();  // kept in [state].file
        g.number("interval_ms", "Interval", [this] { return double(interval_.count()); },
                 [this](double ms) { set_interval(std::chrono::milliseconds(static_cast<long>(ms))); })
            .range(10, 60000, 10)
            .unit("ms");
        g.text("message", "Message", message_);
        g.button("reset", "Reset", [this] { ticks_ = 0; }).confirm("Reset the tick counter?");
        // A command (RPC) with typed parameters: forgectl call burst count=5
        g.command("burst", "Burst", {forge::web::integer_param("count", 3, "ticks to run now").range(1, 100)},
                  [this](const forge::json& a) {
                      const auto n = a["count"].get<int>();
                      for (int i = 0; i < n; ++i) step();  // also while paused
                      return forge::json{{"ticks", ticks_}};
                  })
            .help("Run several ticks immediately");
    }

    // Your own REST API (served by the same HTTP server).
    void setup_http(forge::http::Server& server) override {
        server.get_json("/api/status", [this](const forge::http::Request&) {
            // HTTP handlers run on server threads: invoke() runs this on the main loop.
            return invoke([this] { return forge::json{{"ticks", ticks_}, {"message", message_}}; });
        });
    }

    // Console commands (-i locally, telnet remotely), next to the built-in
    // ones (controls, set, press, call, alarms, metrics, health, trace, ...).
    void setup_console(forge::Console& console) override {
        console.add("ticks", "ticks  show how many times the timer fired",
                    [this, &console](const forge::Console::Args&) { console.print("{}", ticks_); });
    }

    void on_start() override {
        ticks_stream_ = &stream("ticks", "${PKG}.v1.Tick");
        set_interval(interval_);
    }

    void on_reload(const forge::Config& cfg) override {
        apply(cfg);
        set_interval(interval_);
    }

    void on_stop() override { logger()->info("bye after {} ticks", ticks_); }

private:
    void apply(const forge::Config& cfg) {
        interval_ = std::chrono::milliseconds(cfg.get_or<int>("${IDENT}.interval_ms", 1000));
        message_ = cfg.get_or<std::string>("${IDENT}.message", "tick");
    }

    void set_interval(std::chrono::milliseconds interval) {
        interval_ = interval;
        cancel(timer_);
        timer_ = every(interval_, [this] { tick(); });
    }

    void tick() {
        if (!paused_) step();
    }

    void step() {
        FORGE_TRACE_SCOPE("tick");  // shows up in the flight recorder (/forge/ Trace)
        static auto& counter = metrics().counter("${IDENT}.ticks", "Ticks run");
        counter.inc();
        ++ticks_;
        logger()->debug("{} #{}{}", message_, ticks_, dry_run_ ? " (dry run)" : "");
        if (ticks_stream_ && ticks_stream_->wanted()) {  // only when someone listens
            ${PKG}::v1::Tick t;
            t.set_count(ticks_);
            t.set_message(message_);
            t.set_interval_ms(interval_.count());
            ticks_stream_->publish(t);
        }
        // Offload heavy work to the thread pool, report back on the main loop:
        // pool().detach_task([this] { auto r = work(); post([this, r] { use(r); }); });
    }

    bool dry_run_ = false;
    bool paused_ = false;
    std::chrono::milliseconds interval_{1000};
    std::string message_ = "tick";
    std::uint64_t ticks_ = 0;
    forge::Scheduler::Id timer_ = 0;
    forge::zmq::Stream* ticks_stream_ = nullptr;
};
EOF

cat > "${DIR}/src/main.cpp" <<EOF
// ${NAME}: ${DESCRIPTION}
//
//   ./build/${NAME} -c config/${NAME}.toml        # daemon + web UI (Ctrl-C to stop)
//   ./build/${NAME} -c config/${NAME}.toml -i     # plus the local console
//   ./build/${NAME} --help-config                 # every configuration key
//   forgectl -e tcp://localhost:5557 controls     # remote control (forge.v1)
//   telnet localhost 2323                         # remote console
#include "${IDENT}.hpp"

FORGE_MAIN(${CLASS})
EOF

# ---------------------------------------------------------------------------
cat > "${DIR}/config/${NAME}.toml" <<EOF
# ${NAME} configuration (${NAME} --help-config lists every key)
# Override any key from the command line: ${NAME} -D ${IDENT}.interval_ms=500
# Reload at runtime with: systemctl reload ${NAME}   (or kill -HUP <pid>)

[${IDENT}]
interval_ms = 1000
message = "tick"

[log]
level = "info"            # trace|debug|info|warn|error|critical|off
# format = "json"         # one JSON object per line (log collectors)
# file = "/var/log/${NAME}/${NAME}.log"

[threads]
workers = 0               # 0 = number of CPUs
# [threads.rx]            # real-time settings of a thread (app.configure_thread("rx"))
# policy = "fifo"
# priority = 50
# cpus = [1]

[http]
enabled = true            # web UI at http://<host>:8080/ and /forge/
host = "0.0.0.0"
port = 8080

[web]
enabled = true
# root = "web"            # serve web/ from disk while editing (no rebuild)
logs = true               # live log on the control panel

# forge.v1: the same endpoints in every forgecpp application
[forge]
control = "tcp://*:5557"  # requests (forgectl, remote panels)
events = "tcp://*:5559"   # PUB: state, alarms, log, audit, health, metrics
data = "tcp://*:5555"     # PUB: streams ("ticks")

[console]
telnet = "0.0.0.0:2323"   # remote console (empty = off)
# prompt = "${NAME}> "

[state]
file = ""                 # e.g. "/var/lib/${NAME}/state.json": persist() controls survive restarts

# forge-hub (optional): if the device runs one, ${NAME} is on its dashboard
