# ---------------------------------------------------------------------------
[[ ${WITH_STREAM} == 1 ]] && cat > "${DIR}/clients/watch.py" <<EOF
#!/usr/bin/env python3
"""Print ${NAME}'s "ticks" stream: [b"ticks"][forge.stream_header][${PKG}.tick].

    pip install pyzmq protobuf
    ./clients/watch.py tcp://localhost:5555        # installed: forge and ${PKG} in site-packages
    PYTHONPATH=build/python ./clients/watch.py ...   # from the build directory (forgecpp installed)
"""
import sys

import zmq
from forge import framing
from ${PKG} import ${PKG}_pb2

sock = zmq.Context.instance().socket(zmq.SUB)
sock.setsockopt(zmq.SUBSCRIBE, b"ticks")
sock.connect(sys.argv[1] if len(sys.argv) > 1 else "tcp://127.0.0.1:5555")
while True:
    topic, h, t, _ = framing.parse(sock.recv_multipart(), ${PKG}_pb2.tick)
    print(f"{h.source}@{h.host} seq {h.seq}: tick {t.count} (every {t.interval_ms} ms)")
EOF
[[ ${WITH_STREAM} == 1 ]] && chmod +x "${DIR}/clients/watch.py"

# ---------------------------------------------------------------------------
cat > "${DIR}/tests/test_${IDENT}.cpp" <<EOF
#include "${IDENT}.hpp"

#include <forge/remote.hpp>
#include <forge/testing.hpp>
#include <forge/zmq.hpp>

#include <atomic>

using namespace std::chrono_literals;

TEST_CASE("shipped configuration is valid") {
    const auto cfg = forge::Config::load_file(APP_CONFIG_FILE);
    CHECK(cfg.value<int>("${IDENT}.interval_ms") > 0);
}

TEST_CASE("${NAME}: controls, commands and the ticks stream over ZeroMQ") {
    // Ephemeral ports so tests can run in parallel.
    forge::testing::AppRunner<${CLASS}> r({"-D", "forge.control=tcp://127.0.0.1:*", "-D", "forge.data=tcp://127.0.0.1:*",
                                          "-D", "http.enabled=false", "-D", "${IDENT}.interval_ms=10"});
    const auto ep = r->endpoints();

    // {stream
    std::atomic<int> got{0};
    forge::zmq::Receiver::Options o;
    o.topics = {"ticks"};
    forge::zmq::Receiver sub(forge::zmq::Receiver::Kind::sub, ep.at("data"), [&](forge::zmq::Message&& m) {
        if (m.as<${PKG}_tick>().count > 0) ++got;
    }, o);
    CHECK(forge::testing::wait_until([&] { return got > 2; }, 5s));
    // }stream

    forge::Remote app(ep.at("control"));
    app.set("paused", true);
    const auto before = app.get("ticks").get<std::uint64_t>();
    CHECK(app.call("burst", {{"count", 5}})["ticks"] == before + 5);
    CHECK(app.get("paused") == true);

    // {command
    // Its own command, in binary.
    ${PKG}_status_reply status{};
    REQUIRE(app.client().call(${PKG}_msg_id_status, ${PKG}_status_request{}, status).ok());
    CHECK(status.ticks == before + 5);
    CHECK(status.paused);
    // }command
}

// Timer logic without sleeping: the test drives the clock.
TEST_CASE("${NAME}: ticks follow the interval (manual time)") {
    forge::testing::AppRunner<${CLASS}> r({"-D", "http.enabled=false", "-D", "${IDENT}.interval_ms=250"},
                                         {.manual_time = true});
    const auto ticks = [&] { return r->dashboard()->get("ticks").get<std::uint64_t>(); };
    const auto start = r->invoke(ticks);
    r.advance(std::chrono::seconds(1));
    CHECK(r->invoke(ticks) == start + 4);   // exactly 4: no timing slack needed
    r.advance(std::chrono::minutes(1));
    CHECK(r->invoke(ticks) == start + 244);
}
EOF

