critical = false          # its unit failing is a critical alarm on the hub

# Users and roles (viewer < operator < admin) for web, forgectl and telnet.
# Without [auth] everyone is admin: enable it outside the lab.
# [auth]
# enabled = true
# default_role = "viewer"
# [auth.users.admin]
# password = "change-me"
# role = "admin"
# [auth.users.ci]
# token = "secret-token"  # forgectl --token / Authorization: Bearer
# role = "operator"
EOF

# ---------------------------------------------------------------------------
cat > "${DIR}/clients/watch.py" <<EOF
#!/usr/bin/env python3
"""Print ${NAME}'s "ticks" stream: [b"ticks"][forge.v1.Header][${PKG}.v1.Tick].

    pip install pyzmq protobuf
    ./clients/watch.py tcp://localhost:5555        # installed: forge.v1 and ${PKG}.v1 in site-packages
    PYTHONPATH=build/python ./clients/watch.py ...   # from the build directory (forgecpp installed)
"""
import sys

import zmq
from forge.v1 import framing
from ${PKG}.v1 import ${PKG}_pb2

sock = zmq.Context.instance().socket(zmq.SUB)
sock.setsockopt(zmq.SUBSCRIBE, b"ticks")
sock.connect(sys.argv[1] if len(sys.argv) > 1 else "tcp://127.0.0.1:5555")
while True:
    topic, h, t, _ = framing.parse(sock.recv_multipart(), ${PKG}_pb2.Tick)
    print(f"{h.source}@{h.host} seq {h.seq}: tick {t.count} ({t.message}, every {t.interval_ms} ms)")
EOF
chmod +x "${DIR}/clients/watch.py"

# ---------------------------------------------------------------------------
cat > "${DIR}/tests/test_${IDENT}.cpp" <<EOF
#include "${IDENT}.hpp"

#include <forge/testing.hpp>
#include <forge/zmq.hpp>

#include <atomic>

using namespace std::chrono_literals;

TEST_CASE("shipped configuration is valid") {
    const auto cfg = forge::Config::load_file(APP_CONFIG_FILE);
    CHECK(cfg.get_or<int>("${IDENT}.interval_ms", 0) > 0);
}

TEST_CASE("${NAME}: controls, commands and the ticks stream over forge.v1") {
    // Ephemeral ports so tests can run in parallel.
    forge::testing::AppRunner<${CLASS}> r({"-D", "forge.control=tcp://127.0.0.1:*", "-D", "forge.data=tcp://127.0.0.1:*",
                                          "-D", "http.enabled=false", "-D", "${IDENT}.interval_ms=10"});
    const auto ep = r->endpoints();

    std::atomic<int> got{0};
    forge::zmq::Receiver::Options o;
    o.topics = {"ticks"};
    forge::zmq::Receiver sub(forge::zmq::Receiver::Kind::sub, ep.at("data"), [&](forge::zmq::Message&& m) {
        if (m.as<${PKG}::v1::Tick>().count() > 0) ++got;
    }, o);
    CHECK(forge::testing::wait_until([&] { return got > 2; }, 5s));

    forge::zmq::Client c(ep.at("control"));
    c.set("paused", true);
    const auto before = c.get("ticks").get<std::uint64_t>();
    CHECK(c.call_command("burst", {{"count", 5}})["ticks"] == before + 5);
    CHECK(c.get("paused") == true);
}
EOF

