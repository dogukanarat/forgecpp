# Keep or drop the marked parts: "{part" ... "}part" blocks and lines ending in "[part]".
keep() {  # keep <part> <0|1>
    local part="$1" on="$2" f
    while IFS= read -r -d '' f; do
        if [[ ${on} == 1 ]]; then
            sed -i -E "/^ *(\/\/|#) [{}]${part}\$/d; s/ *(\/\/ |# )?\[${part}\]\$//" "${f}"
        else
            sed -i -E "/^ *(\/\/|#) \{${part}\$/,/^ *(\/\/|#) \}${part}\$/d; /\[${part}\]\$/d" "${f}"
        fi
    done < <(find "${DIR}" -type f \( -name '*.cpp' -o -name '*.hpp' -o -name '*.proto' -o -name 'CMakeLists.txt' -o -name '*.md' \) -print0)
}
keep command "${WITH_COMMAND}"
keep stream "${WITH_STREAM}"
keep proto "${WITH_PROTO}"
keep web "${WITH_WEB}"

cat > "${DIR}/.gitignore" <<EOF
/build*/
EOF

echo "Created ${DIR}"
echo
echo "  cd ${DIR}"
echo "  cmake -B build && cmake --build build -j"
