{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{FORGECPP_DEPS}",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "FORGECPP_BUILD_TESTS": "ON",
        "FORGECPP_BUILD_EXAMPLES": "ON"
      }
    },
    {
      "name": "dev",
      "inherits": "base",
      "displayName": "Debug, tests and examples (FORGECPP_DEPS: where install.sh --deps-only put the libraries)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release, tests and examples",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "asan",
      "inherits": "base",
      "displayName": "AddressSanitizer + UBSan (the libraries in FORGECPP_DEPS are not instrumented)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "FORGECPP_SANITIZE": "address;undefined" }
    },
    {
      "name": "tsan",
      "inherits": "base",
      "displayName": "ThreadSanitizer (needs libraries built with install.sh --sanitize thread)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "FORGECPP_SANITIZE": "thread" }
    },
    {
      "name": "fuzz",
      "inherits": "base",
      "displayName": "libFuzzer targets (clang)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "FORGECPP_FUZZ": "ON",
        "FORGECPP_BUILD_EXAMPLES": "OFF"
      }
    },
    {
      "name": "armhf",
      "inherits": "base",
      "displayName": "Zynq-7000 cross build (FORGECPP_DEPS: an armhf prefix from install.sh --toolchain)",
      "toolchainFile": "${sourceDir}/cmake/toolchains/zynq7000-armhf.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "FORGECPP_BUILD_TESTS": "OFF" }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "tsan", "configurePreset": "tsan" },
    { "name": "fuzz", "configurePreset": "fuzz" },
    { "name": "armhf", "configurePreset": "armhf" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 8, "timeout": 300 }
    },
    { "name": "dev", "inherits": "base", "configurePreset": "dev" },
    { "name": "release", "inherits": "base", "configurePreset": "release" },
    {
      "name": "asan",
      "inherits": "base",
      "configurePreset": "asan",
      "environment": { "ASAN_OPTIONS": "detect_leaks=1:abort_on_error=1", "UBSAN_OPTIONS": "print_stacktrace=1" }
    },
    {
      "name": "tsan",
      "inherits": "base",
      "configurePreset": "tsan",
      "environment": { "TSAN_OPTIONS": "halt_on_error=1:second_deadlock_stack=1", "FORGE_TEST_TIMEOUT_SCALE": "4" },
      "execution": { "jobs": 4, "timeout": 900 }
    }
  ],
  "workflowPresets": [
    {
      "name": "dev",
      "steps": [
        { "type": "configure", "name": "dev" },
        { "type": "build", "name": "dev" },
        { "type": "test", "name": "dev" }
      ]
    }
  ]
}
